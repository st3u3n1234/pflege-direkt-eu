---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../../components/Section.astro";
---

<BaseLayout
  title="Anmelden"
  description="Melde dich mit deiner E-Mail-Adresse an, um deine Bewerbung zu verwalten."
>
  <Section eyebrow="Mein Konto" title="Anmelden">
    <div class="max-w-sm">
      <p class="text-sm text-(--color-ink-soft)">
        Gib die E-Mail-Adresse ein, mit der du dich beworben hast. Wir schicken dir einen Anmeldelink
        zu — kein Passwort nötig.
      </p>

      <form id="anmelden-form" class="mt-6 flex flex-col gap-4" novalidate>
        <div>
          <label for="email" class="text-sm font-medium text-(--color-ink)">E-Mail-Adresse</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            autocomplete="email"
            class="mt-1.5 w-full rounded-lg border border-(--color-border-strong) bg-(--color-surface-card) px-3.5 py-2.5 text-sm text-(--color-ink) outline-none focus-visible:border-(--color-primary-600) focus-visible:ring-2 focus-visible:ring-(--color-accent-gold)"
          />
        </div>
        <p id="anmelden-fehler" class="text-sm font-medium text-red-700 dark:text-red-400" role="alert"></p>
        <button
          type="submit"
          id="anmelden-submit"
          class="rounded-full bg-(--color-primary-600) px-6 py-2.5 text-sm font-semibold text-white hover:bg-(--color-primary-700) disabled:opacity-60"
        >
          Anmeldelink zusenden
        </button>
      </form>

      <div id="anmelden-erfolg" hidden class="mt-6 rounded-xl border border-(--color-border) bg-(--color-surface-alt) p-4 text-sm text-(--color-ink-soft)">
        Wir haben dir eine E-Mail mit einem Anmeldelink geschickt. Bitte prüfe dein Postfach (ggf.
        auch den Spam-Ordner).
      </div>
    </div>
  </Section>
</BaseLayout>

<script>
  import { supabase } from "../../lib/supabaseClient";

  const form = document.getElementById("anmelden-form") as HTMLFormElement;
  const submitBtn = document.getElementById("anmelden-submit") as HTMLButtonElement;
  const fehlerEl = document.getElementById("anmelden-fehler") as HTMLElement;
  const erfolgEl = document.getElementById("anmelden-erfolg") as HTMLElement;

  // Bereits eingeloggt? Direkt zum Konto, kein erneuter Link nötig.
  const { data: sessionData } = await supabase.auth.getSession();
  if (sessionData.session) {
    window.location.href = "/konto/";
  }

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    fehlerEl.textContent = "";
    submitBtn.disabled = true;

    const email = (document.getElementById("email") as HTMLInputElement).value.trim();
    const { error } = await supabase.auth.signInWithOtp({
      email,
      options: { emailRedirectTo: `${window.location.origin}/konto/` },
    });

    if (error) {
      fehlerEl.textContent = "Anmeldelink konnte nicht verschickt werden. Bitte versuche es erneut.";
      submitBtn.disabled = false;
      return;
    }

    form.hidden = true;
    erfolgEl.hidden = false;
  });
</script>
