---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import { funnelSchritte, klartextPaare } from "../data/content";
---

<BaseLayout
  title="So funktioniert es"
  description="Der Bewerbungsablauf für die Vermittlung von Pflegefachpersonen, OTA und ATA – Schritt für Schritt erklärt."
>
  <Section eyebrow="Funnel" title="So läuft deine Bewerbung ab">
    <div class="grid gap-10 lg:grid-cols-[1.3fr_1fr]">
      <ol>
        {
          funnelSchritte.map((schritt, index) => (
            <li class="relative flex gap-6 pb-10 last:pb-0">
              {index < funnelSchritte.length - 1 && (
                <span
                  aria-hidden="true"
                  class="absolute top-11 left-5 h-[calc(100%-2.75rem)] w-px bg-(--color-border-strong)"
                />
              )}
              <span class="z-10 flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-(--color-primary-600) text-sm font-bold text-white">
                {schritt.nummer}
              </span>
              <div class="pt-1.5">
                <h3 class="text-base font-bold text-(--color-ink)">{schritt.titel}</h3>
                <p class="mt-1.5 text-sm leading-relaxed text-(--color-ink-soft)">{schritt.beschreibung}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <div class="relative hidden overflow-hidden rounded-2xl lg:block">
        <img
          src="/images/ekg-monitor.jpg"
          alt="EKG-Monitor mit Herzfrequenzkurve"
          loading="lazy"
          class="h-full w-full object-cover"
        />
        <div class="absolute inset-0 bg-(--color-primary-900)/25" aria-hidden="true"></div>
      </div>
    </div>
  </Section>

  <Section
    eyebrow="Klartext"
    title="Ehrlich statt vollmundig"
    lead="Wir versprechen nur, was wir auch halten können."
    alt
  >
    <div class="grid gap-5 md:grid-cols-2">
      {
        klartextPaare.map((paar) => (
          <div class="rounded-2xl border border-(--color-border) bg-(--color-surface-card) p-6">
            <p class="flex gap-2 text-sm text-(--color-ink-faint)">
              <span aria-hidden="true" class="font-bold text-red-700/70 dark:text-red-400">✕</span>
              <span>„{paar.nicht}“</span>
            </p>
            <p class="mt-4 flex gap-2 text-sm font-medium text-(--color-ink)">
              <span aria-hidden="true" class="font-bold text-(--color-primary-600)">✓</span>
              <span>{paar.besser}</span>
            </p>
          </div>
        ))
      }
    </div>
  </Section>
</BaseLayout>
