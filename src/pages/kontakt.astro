---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
---

<BaseLayout
  title="Kontakt"
  description="Kontakt zum Vermittlungsservice für Pflegefachpersonen, OTA und ATA."
>
  <Section eyebrow="Kontakt" title="Wir sind für dich da">
    <p class="max-w-xl text-base leading-relaxed text-(--color-ink-soft)">
      Für eine Vermittlung ist der schnellste Weg das
      <a href="/stelle-finden" class="font-semibold text-(--color-primary-700) underline underline-offset-2">
        Bewerbungsformular
      </a> – so landen deine Angaben direkt bei der richtigen Stelle, ohne
      unnötigen E-Mail-Verkehr.
    </p>
    <p class="mt-6 max-w-xl rounded-xl border border-dashed border-(--color-border-strong) bg-(--color-surface-alt) p-5 text-sm text-(--color-ink-faint)">
      TODO: juristisch/organisatorisch klären – konkrete Kontaktdaten
      (E-Mail-Adresse, Telefonnummer, rechtliche Trägerschaft) stehen noch
      nicht fest.
    </p>
  </Section>
</BaseLayout>
