# Öffentliche Supabase-Projektwerte für das Frontend (PUBLIC_-Präfix macht
# sie im Client-Bundle sichtbar — das ist bei diesen beiden Werten
# beabsichtigt, der anon/publishable Key ist kein Geheimnis).
# Werte findest du im Supabase-Dashboard unter Project Settings → API Keys.
PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
PUBLIC_SUPABASE_ANON_KEY=<anon-oder-publishable-key>
